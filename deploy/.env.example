# Copia este archivo como .env y completa los valores. Nunca subas el .env al repositorio.

# --- Base de datos ---
POSTGRES_DB=shutdownservice
POSTGRES_USER=shutdownservice
POSTGRES_PASSWORD=cambia-esto
DATABASE_URL=postgresql+asyncpg://shutdownservice:cambia-esto@db:5432/shutdownservice

# --- Seguridad ---
# Token que usa el servicio de Windows para conectarse (mínimo 32 caracteres).
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_TOKEN=
# URL pública exacta del panel, sin barra final. Se usa para validar el origen de las peticiones.
PUBLIC_ORIGIN=https://tu-dominio.example
# Duración de la sesión web, en horas.
SESSION_TTL_HOURS=168
# IP o subred del reverse proxy: las únicas cabeceras X-Forwarded-* en las que se confía.
# Así la app ve la IP real del visitante y el límite de intentos de login cuenta por IP.
# Para averiguar la subred de la red del proxy:
#   docker network inspect proxy --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# Si se deja vacío no se confía en ninguna cabecera: la app ve la IP del proxy y el límite
# por IP pasa a ser global (más estricto, pero imposible de evadir falseando una cabecera).
FORWARDED_ALLOW_IPS=

# --- Alexa ---
ALEXA_SKILL_ID=
ALEXA_ALLOWED_USER_ID=

# --- Docker ---
# Nombre de la red Docker compartida del reverse proxy existente.
PROXY_NETWORK=proxy
# Solo desarrollo: puerto local de la API (docker-compose.dev.yml).
API_DEV_PORT=8000

TZ=UTC
