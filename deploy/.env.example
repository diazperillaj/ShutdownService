# Copia este archivo como .env y completa los valores. Nunca subas el .env al repositorio.

# --- Base de datos ---
POSTGRES_DB=shutdownservice
POSTGRES_USER=shutdownservice
POSTGRES_PASSWORD=cambia-esto
DATABASE_URL=postgresql+asyncpg://shutdownservice:cambia-esto@db:5432/shutdownservice

# --- Seguridad ---
# Token que usa el servicio de Windows para conectarse (mínimo 32 caracteres).
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_TOKEN=
# URL pública exacta del panel, sin barra final. Se usa para validar el origen de las peticiones.
PUBLIC_ORIGIN=https://tu-dominio.example
# Duración de la sesión web, en horas.
SESSION_TTL_HOURS=168

# --- Alexa ---
ALEXA_SKILL_ID=
ALEXA_ALLOWED_USER_ID=

# --- Docker ---
# Nombre de la red Docker del reverse proxy existente.
PROXY_NETWORK=caddy

TZ=UTC
